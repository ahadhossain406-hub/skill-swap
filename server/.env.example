PORT=4000

# App-er database user (schema.sql eta banay)
DB_HOST=localhost
DB_PORT=3306
DB_USER=skillswap_user
DB_PASSWORD=skillswap_pass_123
DB_NAME=skillswap

# MySQL root login (shudhu "npm run db:reset" er jonno).
# Mac (Homebrew): password khali. Windows: MySQL install-er shomoy je password diyecho.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173